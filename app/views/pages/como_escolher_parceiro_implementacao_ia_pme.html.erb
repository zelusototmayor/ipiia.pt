<td>/2</td>
</tr>
<tr>
<th scope="row">Autonomia por risco</th>
<td>/2</td>
</tr>
<tr>
<th scope="row">Testes e aprovação</th>
<td>/2</td>
</tr>
<tr>
<th scope="row">Custo total</th>
<td>/2</td>
</tr>
<tr>
<th scope="row">Reversibilidade</th>
<td>/2</td>
</tr>
<tr>
