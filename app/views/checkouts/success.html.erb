<div id="nav-mount"></div>

<section class="page-hero">
  <div class="container">
    <span class="eyebrow fade-in">Compra concluída</span>
    <h1 class="fade-in delay-1">O curso ficou <em>desbloqueado</em>.</h1>
    <p class="lead fade-in delay-2">
      Enviámos o link de acesso para o email usado no checkout. Pode regressar ao curso
      a qualquer momento pedindo um novo link de entrada.
    </p>
    <div class="hero-actions fade-in delay-3">
      <%= link_to @enrollment.present? ? "Continuar para o curso" : "Entrar no curso",
                  @enrollment.present? ? course_dashboard_path : new_course_session_path,
                  class: "btn btn-primary" %>
      <%= link_to "Voltar ao site", root_path, class: "btn btn-secondary" %>
    </div>
  </div>
</section>

<div id="footer-mount"></div>
