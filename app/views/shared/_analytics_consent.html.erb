<% if (config = analytics_client_config) %>
  <section class="analytics-consent" aria-label="Preferências de analytics" data-analytics-consent data-config="<%= config.to_json %>">
    <p>Analytics opcional: medir a utilização do site com um identificador anónimo. A escolha aplica-se apenas até recarregar a página.</p>
    <p data-consent-status role="status" aria-live="polite">Analytics não autorizado.</p>
    <div class="analytics-consent-actions">
      <button type="button" data-consent-choice="accept">Aceitar analytics</button>
      <button type="button" data-consent-choice="reject">Rejeitar analytics</button>
      <button type="button" data-consent-choice="revoke" hidden>Revogar analytics</button>
    </div>
  </section>
<% end %>
