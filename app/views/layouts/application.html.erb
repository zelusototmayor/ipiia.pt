<!DOCTYPE html>
<html lang="pt">
  <head>
    <% page_title = @page_title || "IPIIA — Instituto Português de Implementação de IA" %>
    <% meta_description = @meta_description || "Diagnóstico, formação e implementação de IA para PMEs portuguesas." %>
    <title><%= page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= meta_description %>">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">

    <meta property="og:site_name" content="IPIIA — Instituto Português de Implementação de IA">
    <meta property="og:type" content="website">
    <meta property="og:title" content="<%= page_title %>">
    <meta property="og:description" content="<%= meta_description %>">
    <meta property="og:url" content="<%= @canonical_path ? "#{request.base_url}#{@canonical_path}" : request.original_url %>">
    <meta property="og:locale" content="pt_PT">
    <% if @canonical_path %>
      <link rel="canonical" href="<%= "#{request.base_url}#{@canonical_path}" %>">
    <% end %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <%= favicon_link_tag "logo-operations-cube-v2.png", type: "image/png" %>

    <%= stylesheet_link_tag "shared", "styles", "operations", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "lucide.min", defer: true %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= render "shared/nav" %>
    <% if notice.present? || alert.present? %>
      <div class="flash-stack">
        <% if notice.present? %><div class="flash flash-notice"><%= notice %></div><% end %>
        <% if alert.present? %><div class="flash flash-alert"><%= alert %></div><% end %>
      </div>
    <% end %>
    <%= yield %>
    <%= render "shared/footer" %>
  </body>
</html>
